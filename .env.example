# .env.example - contains no real credentials.
# Copy this file to ".env" (which is git-ignored) and fill in your own values.
LLM_PROVIDER=gemini
# Check Google AI Studio for a model that is currently free, and put its exact name here:
LLM_MODEL=YOUR_MODEL_NAME_HERE
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Optional local model through Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=YOUR_OLLAMA_MODEL_HERE
